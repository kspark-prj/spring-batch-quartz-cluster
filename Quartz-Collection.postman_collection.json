          ],
          "port": "8080",
          "path": [
            "api",
            "quartz",
            "status"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. 동적 Cron Job 추가 등록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"jobName\": \"DynamicBatchJob-1\",\n    \"jobGroup\": \"BATCH_GROUP\",\n    \"cronExpression\": \"0/15 * * * * ?\",\n    \"jobData\": {\n        \"triggerReason\": \"Manual creation for debug\",\n        \"limitCount\": 5000\n    }\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/quartz/jobs?type=BATCH",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "quartz",
            "jobs"
          ],
          "query": [
            {
              "key": "type",
              "value": "BATCH",
              "description": "BATCH 또는 MONITOR 기동 모드 매핑"
            }
          ]
        }
      },
      "response": []
    },
